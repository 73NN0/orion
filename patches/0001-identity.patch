Orion identity: product name, basegame, home path and config prefix.
Touches cmake/identity.cmake, the #ifdef STANDALONE block of
code/qcommon/q_shared.h, and cmake/renderer_common.cmake so that the
dlopen'd renderer (which creates the window) also sees STANDALONE.
Upstream formatting is left untouched.
Base: ioquake3 588393618dbc82e7207c21c6ddecca229944a03a

diff --git a/cmake/identity.cmake b/cmake/identity.cmake
index e90934c7..ba7862f8 100644
--- a/cmake/identity.cmake
+++ b/cmake/identity.cmake
@@ -1,10 +1,10 @@
-set(PROJECT_NAME ioq3)
-set(PROJECT_VERSION 1.36)
+set(PROJECT_NAME orion)
+set(PROJECT_VERSION 0.1.0)
 
-set(SERVER_NAME ioq3ded)
-set(CLIENT_NAME ioquake3)
+set(SERVER_NAME orionded)
+set(CLIENT_NAME orion)
 
-set(BASEGAME baseq3)
+set(BASEGAME reach)
 
 set(CGAME_MODULE cgame)
 set(GAME_MODULE qagame)
@@ -13,9 +13,9 @@ set(UI_MODULE ui)
 set(WINDOWS_ICON_PATH ${CMAKE_SOURCE_DIR}/misc/windows/quake3.ico)
 
 set(MACOS_ICON_PATH ${CMAKE_SOURCE_DIR}/misc/macos/quake3_flat.icns)
-set(MACOS_BUNDLE_ID org.ioquake.${CLIENT_NAME})
+set(MACOS_BUNDLE_ID org.73nn0.${CLIENT_NAME})
 
-set(COPYRIGHT "QUAKE III ARENA Copyright © 1999-2000 id Software, Inc. All rights reserved.")
