-set(CONTACT_EMAIL "info@ioquake.org")
-set(PROTOCOL_HANDLER_SCHEME quake3)
+set(CONTACT_EMAIL "orion@oni.reach")
+set(PROTOCOL_HANDLER_SCHEME orion)
diff --git a/cmake/renderer_common.cmake b/cmake/renderer_common.cmake
index 277bf46a..51abea73 100644
--- a/cmake/renderer_common.cmake
+++ b/cmake/renderer_common.cmake
@@ -27,6 +27,12 @@ if(USE_FREETYPE)
     list(APPEND RENDERER_DEFINITIONS BUILD_FREETYPE)
 endif()
 
+# The dlopen'd renderer compiles sdl_glimp.c: without this, the window
+# title and other STANDALONE identity values fall back to ioquake3.
+if(BUILD_STANDALONE)
+    list(APPEND RENDERER_DEFINITIONS STANDALONE)
+endif()
+
 if(USE_RENDERER_DLOPEN)
     list(APPEND RENDERER_DEFINITIONS USE_RENDERER_DLOPEN)
 elseif(BUILD_RENDERER_GL1 AND BUILD_RENDERER_GL2)
